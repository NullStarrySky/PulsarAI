{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"host/desktop-electron/main.mjs",
		"host/desktop-electron/preload.cjs",
		"host/mobile-tauri/index.ts"
	],
	"project": [
		"src/**/*.{ts,tsx,vue}",
		"host/**/*.{ts,mjs,cjs}",
		"scripts/**/*.ts",
		"src/**/*.css"
	],
	"ignore": [
		"src/components/**",
		"src/features/Migrations/**",
		"src/features/Tabs/subWindow/**"
	],
	"ignoreDependencies": [
		"@ai-sdk/provider-utils",
		"@codemirror/lang-javascript",
		"@codemirror/lang-json",
		"@codemirror/lang-vue",
		"@tanstack/vue-table",
		"@tauri-apps/cli",
		"codemirror",
		"embla-carousel-vue",
		"vaul-vue",
		"vee-validate",
		"vue-sonner"
	]
}

{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "pulsarai",
	"version": "0.1.0",
	"identifier": "com.nullstarrysky.pulsarai",
	"build": {
		"beforeDevCommand": "bun run renderer:dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run renderer:build",
		"frontendDist": "../../dist"
	},
	"app": {
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
